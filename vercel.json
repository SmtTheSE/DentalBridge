{
    "version": 2,
    "builds": [
        {
            "src": "DentalBridge/backend/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "DentalBridge/frontend/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "DentalBridge/backend/main.py"
        },
        {
            "src": "/(.*)",
            "dest": "DentalBridge/frontend/$1"
        }
    ]
}